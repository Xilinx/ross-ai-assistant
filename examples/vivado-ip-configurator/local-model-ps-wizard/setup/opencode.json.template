{
  "$schema": "https://opencode.ai/config.json",
  "model": "lemonade/@MODEL_ID@",
  "provider": {
    "lemonade": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Lemonade",
      "options": {
        "baseURL": "@LEMONADE_URL@",
        "apiKey": "lemonade",
        "timeout": 1800000
      },
      "models": {
        "@MODEL_ID@": {
          "name": "@MODEL_ID@",
          "tools": true,
          "limit": { "context": 131072, "output": 32768 },
          "options": { "temperature": 1.0, "top_p": 0.95, "top_k": 64 }
        }
      }
    }
  },
  "agent": {
    "build": {
      "steps": 100,
      "options": {
        "chat_template_kwargs": { "enable_thinking": false },
        "min_p": 0.0
      }
    }
  },
  "permission": {
    "*": "deny",
    "external_directory": { "*": "deny" },
    "read": { "*": "allow" },
    "skill": { "*": "deny", "vivado-ip-configurator": "@SKILL_PERMISSION@" },
    "vivado_vivado_start": "allow",
    "vivado_vivado_execute": "allow",
    "vivado_vivado_stop": "allow"
  },
  "tools": {
    "list_mcp_resource_templates": false,
    "list_mcp_resources": false,
    "read_mcp_resource": false
  },
  "mcp": {
    "vivado": {
      "type": "local",
      "command": ["@VIVADO_MCP_SERVER@", "--stdio",
                  "--vivado-path=@VIVADO_PATH@", "--allow-path-override=never",
                  "--state-dir=@TRIAL_DIR@/.vivado-mcp-state"],
      "enabled": true,
      "timeout": 300000
    }
  }
}
