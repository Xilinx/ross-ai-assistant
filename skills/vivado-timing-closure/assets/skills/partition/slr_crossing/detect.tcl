# =============================================================================
# Partition / SLR Crossing Detection
# =============================================================================
# Runs inside Vivado session after post-route physopt.
# Detects critical paths crossing SLR boundaries.
# If detected, generates a pblock XDC fix in the run directory.
#
# Output:
#   <run_dir>/partition_slr_crossing_fix.xdc  (if problem found)
#   <run_dir>/slr_crossing_detected.flag      (flag file)
# =============================================================================

# Get run directory from environment or argument
if {[info exists env(RUN_DIR)]} {
    set run_dir $env(RUN_DIR)
} else {
    set run_dir [pwd]
}

puts "\[DETECT\] Checking for SLR crossing problems..."

# Get top 10 failing setup paths
set paths [get_timing_paths -max_paths 10 -delay_type max -slack_lesser_than 0]

if {[llength $paths] == 0} {
    puts "\[DETECT\] No failing paths — skipping SLR crossing check."
    return
}

set crossing_count 0
set total_paths [llength $paths]

foreach path $paths {
    set slr_crossings [get_property SLR_CROSSINGS $path]
    if {$slr_crossings != "" && $slr_crossings > 0} {
        incr crossing_count
    }
}

puts "\[DETECT\] SLR crossings: $crossing_count / $total_paths failing paths"

if {$crossing_count < 3} {
    puts "\[DETECT\] SLR crossing below threshold (< 3 paths) — no action needed."
    return
}

puts "\[DETECT\] SLR crossing problem detected! Generating fix..."

# Write detection flag
set flag_file [file join $run_dir "slr_crossing_detected.flag"]
set fp [open $flag_file w]
puts $fp "SLR_CROSSING_DETECTED"
puts $fp "crossing_paths=$crossing_count"
puts $fp "total_paths=$total_paths"
close $fp

# ---- additive, structured result.json (does not affect detection/fix logic) ----
if {[catch {
    proc _rj_esc {s} { return [string map {\\ \\\\ \" \\\" \n \\n \r \\r \t \\t} $s] }
    proc _rj_str {v} { return "\"[_rj_esc $v]\"" }
    proc _rj_bool {v} { return [expr {$v ? "true" : "false"}] }
    proc _rj_obj {pairs} {
        set m {}
        foreach {k t v} $pairs {
            set vv [expr {$t eq "s" ? [_rj_str $v] : ($t eq "b" ? [_rj_bool $v] : $v)}]
            lappend m "\"$k\": $vv"
        }
        return "\{[join $m ", "]\}"
    }
    set _rj_counts [_rj_obj [list crossing_paths n $crossing_count total_paths n $total_paths]]
    set _rj_ts [clock format [clock seconds] -format {%Y-%m-%dT%H:%M:%S}]
    set _rj_cond "$crossing_count of $total_paths worst failing setup paths cross an SLR boundary (threshold: >=3)"
    set _rj_changes "No constraint applied; partition_slr_crossing_fix.xdc contains only informational path/SLR annotations, no pblock/LOC constraints"
    set _rj_top [_rj_obj [list schema_version n 1 skill s "slr_crossing" category s "partition" \
        detected b 1 generated_at s $_rj_ts trigger_condition s $_rj_cond design_changes s $_rj_changes]]
    set _rj_json "\{\n  [string range $_rj_top 1 end-1],\n  \"counts\": $_rj_counts\n\}\n"
    set _rj_fh [open [file join $run_dir "slr_crossing_result.json"] w]
    puts -nonewline $_rj_fh $_rj_json
    close $_rj_fh
} _rj_err]} {
    puts "\[DETECT\] WARNING: could not write slr_crossing_result.json: $_rj_err"
}

# Generate partition fix XDC using suggest_slr_partition
# This generates pblock constraints to keep critical modules in same SLR
if {[catch {
    set xdc_file [file join $run_dir "partition_slr_crossing_fix.xdc"]

    # Analyze which cells are causing crossings and suggest pblock assignments
    set fp [open $xdc_file w]
    # try/finally so $fp always gets closed even if a path below throws --
    # every get_property/get_cells/get_pins call in this loop now uses
    # -quiet and skips (continue) a malformed path instead of letting an
    # unguarded call abort mid-loop; without -quiet, a startpoint/endpoint
    # on a top-level PORT (not a register pin -- a completely normal
    # occurrence for I/O timing paths) makes STARTPOINT_PIN/ENDPOINT_PIN
    # return empty, so get_property SLR_INDEX on the resulting empty cell
    # list throws -- which used to abort this whole loop after the first
    # such path (discarding comments already written for earlier paths)
    # and leak $fp since close $fp below was never reached.
    try {
        puts $fp "# Auto-generated SLR partition fix"
        puts $fp "# Generated by: skills/partition/slr_crossing/detect.tcl"
        puts $fp "# Crossing paths: $crossing_count / $total_paths"
        puts $fp ""

        # For each crossing path, identify source/destination SLRs
        foreach path $paths {
            set slr_crossings [get_property -quiet SLR_CROSSINGS $path]
            if {$slr_crossings != "" && $slr_crossings > 0} {
                set startpoint [get_property -quiet STARTPOINT_PIN $path]
                set endpoint [get_property -quiet ENDPOINT_PIN $path]
                if {$startpoint eq "" || $endpoint eq ""} { continue }
                set start_cell [get_cells -quiet -of_objects [get_pins -quiet $startpoint]]
                set end_cell [get_cells -quiet -of_objects [get_pins -quiet $endpoint]]
                if {[llength $start_cell] == 0 || [llength $end_cell] == 0} { continue }
                set start_slr [get_property -quiet SLR_INDEX $start_cell]
                set end_slr [get_property -quiet SLR_INDEX $end_cell]
                set slack [get_property -quiet SLACK $path]
                puts $fp "# Path: $startpoint -> $endpoint (slack=$slack, SLR$start_slr -> SLR$end_slr)"
            }
        }
    } finally {
        catch {close $fp}
    }
    puts "\[DETECT\] Fix XDC written to: $xdc_file"

} err]} {
    puts "\[DETECT\] Warning: Could not generate fix XDC: $err"
}
