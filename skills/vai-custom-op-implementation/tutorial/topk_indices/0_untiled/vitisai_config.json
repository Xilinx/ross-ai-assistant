{
  "passes": [
    {
      "name": "vaiml_partition",
      "plugin": "vaip-pass_vaiml_partition",
      "vaiml_config": {
        "device": "ve2",
        "keep_outputs": true,
        "optimize_level": 3,
        "no_failsafe": true,
        "enable_f32_to_bf16_conversion": true,
        "debug_level": 9,
        "logging_level": "info",
        "experiment_features": [
          "KeepOrphanNodes"
        ],
        "fe_args": "",
        "max_num_partitions": -1,
        "threshold_gops_percent": 0,
        "aiecompiler_args": "--compile-for-x86sim=true --x86sim-as-shared-library=true",
        "runner_type": "x86sim",
        "custom_ops": {
          "cse.topk_indices": {
            "op_config": "topk_indices/config.yaml"
          }
        }
      }
    }
  ],
  "target": "VAIML",
  "targets": [
    {
      "name": "VAIML",
      "pass": [
        "vaiml_partition"
      ]
    }
  ]
}
